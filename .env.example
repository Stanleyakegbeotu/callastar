# Public Supabase values only. A service-role key must never appear in a Vite
# env file - it would ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where admin profiles, media and call sessions live.
#   local     browser IndexedDB, used while Supabase is not connected
#   supabase  the production path
# Unset defaults to local in a dev build and supabase in a production build.
VITE_ADMIN_DATA_MODE=local

# Development-only admin access, honoured solely in a dev build. Remove it to
# require a provisioned Supabase administrator.
VITE_ADMIN_AUTH_MODE=development

# Where the public app resolves Call IDs. Unset follows VITE_ADMIN_DATA_MODE.
#   local     profiles created in the local dashboard
#   supabase  the deployed Edge Functions
#   mock      the built-in demo host, for deliberate offline UI work
VITE_CALL_BACKEND=local

# Development aid: play the bundled clip instead of the real camera.
# VITE_ENABLE_DEMO_VIDEO=true

# Hidden five-tap shortcut on the onboarding brand mark, which opens /admin.
# A development inspection convenience, NOT an authentication mechanism: it is
# gated on import.meta.env.DEV as well as this flag, so a production build
# compiles it away entirely.
# VITE_ENABLE_DEV_ADMIN_SHORTCUT=true

# Pacing of the in-call subscription checkpoint, in milliseconds. Unset, the
# call plays for a random 10-15s before access is checked and the check takes
# 5-8s. Set these only to make automated tests quick; they change what a person
# actually experiences on a call.
# VITE_SUBSCRIPTION_PREVIEW_MS=2000
# VITE_SUBSCRIPTION_CHECK_MS=1500

# Fallback WhatsApp support number for a workspace where no administrator has
# saved one yet. The value in Admin > Settings always wins, so this is only a
# convenience for a fresh local install. Never commit a personal number.
# VITE_SUPPORT_WHATSAPP_NUMBER=

# The private-site access gate is configured only in Netlify's Edge Function
# environment as ACCESS_GATE_SECRET. It must never be a VITE_ variable or be
# committed here; see docs/PRIVATE_ACCESS_GATE.md.

# ---------------------------------------------------------------------------
# Real-time calling
#
# See server/signaling/README.md for how to run the service and what still
# needs deploying. Live calling is OFF when VITE_SIGNALING_URL is unset - that
# is not a fallback to something local, because no local transport can reach a
# second phone.
# ---------------------------------------------------------------------------

# Which SignalingProvider implementation backs live calling.
#   websocket  the service in server/signaling (the working path)
#   supabase   Supabase Realtime - deliberately NOT implemented yet
# VITE_SIGNALING_TRANSPORT=websocket

# Address of the signalling service. A browser will not open ws:// from an
# HTTPS page, so a deployed build needs wss://.
# VITE_SIGNALING_URL=ws://localhost:8787

# ICE servers, comma-separated.
#
# TURN is NOT optional in production. Mobile carrier NAT, CGNAT and restricted
# Wi-Fi all require a relay, and calls on those networks simply fail without
# one. Development may run on STUN alone; such a build must not be described as
# production ready, and describeRtcReadiness() reports the difference.
#
# Use short-lived TURN credentials. Anything in a VITE_ variable ships to the
# browser and is therefore public - never put a long-lived TURN secret here.
# VITE_RTC_STUN_URLS=stun:stun.l.google.com:19302
# VITE_RTC_TURN_URLS=turns:turn.example.com:5349
# VITE_RTC_TURN_USERNAME=
# VITE_RTC_TURN_CREDENTIAL=

# Operator credential for live host calling. DEVELOPMENT ONLY: anything in a
# VITE_ variable is compiled into the bundle and is therefore public, and a
# public host credential would let a stranger register as any profile and answer
# its calls. `hostSignalingToken` in lib/config.ts is gated on
# import.meta.env.DEV as well, so a production build compiles it away entirely.
# Production needs a short-lived per-operator token minted from the admin
# session - see server/signaling/README.md, outstanding item 3.
# Must match SIGNALING_HOST_SECRET on the service.
# VITE_SIGNALING_HOST_TOKEN=

# Product deadlines, in milliseconds. Set only to stop an automated suite
# sitting through them; they change what a real caller experiences. The ring
# timeout must be configured alongside SIGNALING_RING_TIMEOUT_MS on the service,
# which remains authoritative.
# VITE_RING_TIMEOUT_MS=35000
# VITE_SOURCE_SELECTION_MS=12000
